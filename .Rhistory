rename(sst_effect_median = effect_median), by = "CU") %>%
left_join(effect_sizes_cu_df(ric_chm_cpd_ocean_covariates_logR, effect = "npgo", species = "chum") %>%
rename(npgo_effect_median = effect_median), by = "CU")
