foo_forestry = c(10,50,60,90,100,90,80,60)
foo_y = rnorm(mean = 0.2*foo_forestry,sd = 1, n = length(foo_forestry))
lm(foo_y~foo_forestry)
foo_forestry_sqrt = sqrt(foo_forestry)
lm(foo_y~foo_forestry_sqrt)
foo_forestry_sqrt_std = scale(sqrt(foo_forestry))
foo_forestry_std = scale(foo_forestry)
lm(foo_y~foo_forestry_sqrt_std)
lm(foo_y~foo_forestry_std)
